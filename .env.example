# Copie vers .env.local et renseigne tes valeurs Supabase
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TON_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TON_ANON_KEY

# Clé service_role (secrète) — pour créer des agents déjà confirmés depuis Équipe
# Ne jamais committer ni exposer côté navigateur. Aussi dans Vercel → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=TON_SERVICE_ROLE_KEY
